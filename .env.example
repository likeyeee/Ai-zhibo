# 复制为仓库根目录的 .env 后按需修改。
# 不填密钥时，话术、语音和数字人都会走本地模拟，可以直接开播。

HOST=0.0.0.0
PORT=8787
WEB_ORIGIN=http://localhost:5173

# 留空则使用 server/data
DATA_DIR=

# 话术：mock（本地模板）或 openai（任何兼容 Chat Completions 的服务）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 语音：lingbo 为本机数字人服务（默认，服务没起来就退回按时长估算）
# 也可选 mock、http，或克隆音色 cosyvoice / gpt-sovits / f5（见 README）
TTS_PROVIDER=lingbo
TTS_HTTP_URL=
TTS_API_KEY=
# 三个克隆引擎都要这段参考音频的路径，以及音频里说的字
CLONE_REF_AUDIO=
CLONE_REF_TEXT=
COSYVOICE_URL=
GPT_SOVITS_URL=
F5_TTS_URL=

# 形象：lingbo 为本机数字人服务（默认）。服务没起来，或这一句没有 MuseTalk 口型视频时，用二维肖像。
# local 为只画肖像；http 为每句口播换一段视频；livekit 使用房间里的远程形象轨（可接付费形象插件）；
# video 为循环视频；heygem 为本机 Duix HeyGem 的离线成片；musetalk 为另一套只动嘴的 HTTP 口型
AVATAR_PROVIDER=lingbo
# 本机数字人服务，见 services/lingbo-avatar
LINGBO_AVATAR_URL=http://127.0.0.1:8790
# 等口型视频的最长时间。超时后这一句仍用二维口型，语音继续
LINGBO_CLIP_TIMEOUT_MS=15000
AVATAR_VIDEO_URL=
AVATAR_HTTP_URL=
AVATAR_API_KEY=
MUSETALK_URL=
# HeyGem 只在 AVATAR_PROVIDER=heygem 时使用。数据目录要和 gen-video 容器读文件的目录是同一份。
HEYGEM_VIDEO_URL=http://127.0.0.1:8383
HEYGEM_TTS_URL=http://127.0.0.1:18180
HEYGEM_DATA_DIR=
HEYGEM_VIDEO_PATH=
# 可选。按主播换驱动视频，例如 lin=lin.mp4,heng=heng.mp4
HEYGEM_HOST_VIDEOS=
HEYGEM_REFERENCE_AUDIO=
HEYGEM_REFERENCE_TEXT=
# 口播最多等多少毫秒再退回本地肖像。0 表示不等，先播本地，成片好了下一轮再用。
HEYGEM_SCRIPT_WAIT_MS=0
HEYGEM_REPLY_WAIT_MS=0

# 开播后自动丢几条演示评论，方便单人试用。正式演练可设为 false
SIMULATE_VIEWERS=true
SIMULATE_INTERVAL_MS=9000

# 口播停顿倍率。1 为正常语速停顿，小于 1 会更快讲完一轮
SPEECH_PAUSE_SCALE=1

# 实时音视频：local 只用本机 WebSocket；livekit 时浏览器把主播画面推进 LiveKit 房间
# 本地试用见 README。开发模式的默认密钥是 devkey / secret
REALTIME_PROVIDER=local
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# browser：控制台采集导播画面并推流。agent：只发数据，由 agent/ 里的 LiveKit Agents worker 进房。
# lingbo：浏览器不推音视频，由本机数字人服务以身份 lingbo-avatar 进房。要先有 LiveKit 和本机服务。
LIVEKIT_HOST_PUBLISHER=browser
LIVEKIT_AGENT_NAME=lingbo-host

# 播出：mock 只记状态；ffmpeg 用本机 ffmpeg 把字幕和商品合成后推 RTMP；
# livekit 用 LiveKit Egress 打开 /program/<场次> 合成数字人画面，再推到各平台
OUTPUT_PROVIDER=mock
# Egress 容器访问播出页的地址。本机 Docker 一般是 http://host.docker.internal:5173
PROGRAM_BASE_URL=
# 可选。不填时会找系统里的文泉驿或 Droid 中文字体
OUTPUT_FONT=
# 用来加密串流密钥。不填则在数据目录生成 output.key
OUTPUT_SECRET=
# 平台评论回调要带这个令牌（请求头 X-Lingbo-Ingest-Token，或 JSON 字段 ingestToken）
INGEST_TOKEN=
